{
  "name": "dots-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "dots 的桌面界面",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"electron/**/*.test.js\"",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.dotsagent.desktop",
    "productName": "dots",
    "copyright": "MIT",
    "directories": {
      "output": "../release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "dots",
      "artifactName": "dots-${version}-setup.${ext}"
    }
  }
}
